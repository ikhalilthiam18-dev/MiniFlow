# Copier ce fichier en .env (il n'est pas versionné) et adapter les valeurs.

# Développement : True. Production : False (valeur par défaut si absent).
DJANGO_DEBUG=True

# Obligatoire en production (DJANGO_DEBUG=False). Générer une clé avec :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Domaines autorisés, séparés par des virgules
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origines autorisées à appeler l'API (frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Base de données : "sqlite" (défaut) ou "postgres"
DB_ENGINE=sqlite
DB_NAME=courrier360
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# E-mails (sans EMAIL_HOST : affichés dans la console du serveur)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Mairie de Ziguinchor <courrier@mairie-ziguinchor.sn>
FRONTEND_URL=http://localhost:5173
